{
  "name": "mcts-cuisine",
  "version": "0.1.0",
  "private": true,
  "description": "Une cuisine à la Overcooked : un cuisinier humain et des robots qui devinent ce qu'il va faire.",
  "type": "module",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "test": "node --test",
    "test:coverage": "node --test --experimental-test-coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "types": "tsc -p .",
    "check": "npm run lint && npm run types && npm test",
    "compare": "node scripts/compare.js",
    "tranches": "node scripts/tranches.js",
    "bench": "node scripts/search-bench.js",
    "replay": "node scripts/replay.js",
    "page": "node node_modules/mcts-commun/bin/serve.js 4803",
    "prepare": "git config core.hooksPath .githooks",
    "changelog": "node scripts/changelog.js"
  },
  "author": "Sami",
  "license": "UNLICENSED",
  "dependencies": {
    "mcts-commun": "file:../mcts-commun"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.19.2",
    "eslint": "^9.39.5",
    "eslint-plugin-sonarjs": "^4.2.1",
    "globals": "^17.12.0",
    "typescript": "^5.9.3"
  }
}
